# ---- PayPal (sandbox) ----
# Main REST app: used for Invoicing v2 (invoices, recurring series, reminders, QR codes) and Transaction Search.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Business email of the main sandbox account (shown as the invoicer).
PAYPAL_MERCHANT_EMAIL=

# Optional second REST app for Payouts.
# Why: a sandbox business account in some regions (e.g. India) cannot send Payouts (PAYOUT_NOT_AVAILABLE),
# and foreign-currency invoices cannot be sent to Indian sandbox buyers. A US-region sandbox app is used
# for disbursing the pot. When unset, payouts fall back to the main app and any PAYOUT_NOT_AVAILABLE
# response is recorded in the ledger as "queued (region)" so the demo still completes.
PAYPAL_US_CLIENT_ID=
PAYPAL_US_CLIENT_SECRET=
PAYPAL_US_MERCHANT_EMAIL=

# Sandbox account that receives the first member's real invoices (defaults to PAYPAL_US_MERCHANT_EMAIL).
PAYPAL_DEMO_PAYER_EMAIL=

# ---- AI (Claude) ----
# Optional. Without a key the app runs with a deterministic parser and keyword chat.
ANTHROPIC_API_KEY=
# Optional. Route through Vercel AI Gateway with ANTHROPIC_BASE_URL=https://ai-gateway.vercel.sh
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Storage ----
# Optional Upstash Redis (recommended on Vercel). Falls back to .data/circles.json locally.
# Vercel injects KV_REST_API_URL / KV_REST_API_TOKEN when Upstash is connected; either naming works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DATA_DIR=.data
